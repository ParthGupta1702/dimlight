PORT=5000

# MongoDB in Docker (npm run db:up). For MongoDB Atlas use the mongodb+srv://... string from Atlas instead.
MONGODB_URI=mongodb://127.0.0.1:27017/dimlight

# Any long random string. Used to sign login tokens.
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=2h

# Seat hold: how long a Pending booking keeps its seats before they are released
HOLD_MINUTES=5

# Mock payment "processing" delay (ms) so the frontend can show a payment animation
MOCK_PAYMENT_DELAY_MS=1200

# Seeded admin account (created by npm run db:setup)
ADMIN_EMAIL=admin@dimlight.com
ADMIN_PASSWORD=Admin@12345
